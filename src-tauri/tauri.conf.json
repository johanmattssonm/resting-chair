{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "resting-chair",
  "version": "1.0.0",
  "identifier": "com.kajacode.resting-chair",
  "build": {
    "beforeDevCommand": "npm run build:wasm && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Resting Chair",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Johan Mattsson",
    "homepage": "https://kajacode.com",
    "copyright": "Copyright © 2026 Johan Mattsson",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "REST calls",
    "longDescription": "A desktop application for creating and sending REST requests.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
